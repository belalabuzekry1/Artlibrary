{
  "name": "artlibrary",
  "compatibility_date": "2026-11-12",
  "main": "src/worker.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "artlibrary.ai", "custom_domain": true },
    { "pattern": "www.artlibrary.ai", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin.html", "/img/*"]
  },
  "vars": {
    "GOOGLE_CLIENT_ID": "292699826221-jje3cmb83aeo0e58nnvet9n4p4e6oupp.apps.googleusercontent.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "artlibrary",
      "database_id": "c95ccc45-53cb-41fc-9365-8b46b76d2977"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "artlibrary-artworks"
    }
  ]
}
